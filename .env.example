# LLM Provider (provider-agnostic defaults)
LLM_BACKEND=openai_compat
LLM_API_KEY=your_provider_api_key_here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_GENERATION_MODEL=mistral-small-latest
LLM_MODERATION_MODEL=mistral-moderation-latest
LLM_EMBEDDING_MODEL=mistral-embed

# Backward-compatible aliases still supported
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_GENERATION_MODEL=
MISTRAL_MODERATION_MODEL=
MISTRAL_EMBEDDING_MODEL=

# Backend
SERVER_PORT=3200
SLED_DB_PATH=prompt_sentinel_data
RUST_LOG=info

# Security
CORS_ALLOW_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Authentication and RBAC (Phase 2 bootstrap)
AUTH_ENABLED=false
# Format: token:role OR label:token:role (comma-separated)
AUTH_API_KEYS=dev-token:developer,viewer-token:compliance_viewer,admin-token:compliance_admin
AUTH_SERVICE_TOKENS=ci-token:service_account
AUTH_RATE_LIMIT_PER_MINUTE=300

# LLM HTTP reliability
LLM_REQUEST_TIMEOUT_SECS=120
LLM_CONNECT_TIMEOUT_SECS=10
LLM_POOL_MAX_IDLE_PER_HOST=20
LLM_POOL_IDLE_TIMEOUT_SECS=90
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_OPEN_DURATION_SECS=30

# Frontend
FRONTEND_PORT=5175
VITE_API_BASE_URL=http://localhost:3200

# Semantic config
SEMANTIC_MEDIUM_THRESHOLD=0.70
SEMANTIC_HIGH_THRESHOLD=0.80
SEMANTIC_DECISION_MARGIN=0.02
