# LLM Provider (provider-agnostic defaults)
LLM_BACKEND=openai_compat
LLM_API_KEY=your_provider_api_key_here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_GENERATION_MODEL=mistral-small-latest
LLM_MODERATION_MODEL=mistral-moderation-latest
LLM_EMBEDDING_MODEL=mistral-embed

# Backward-compatible aliases still supported
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_GENERATION_MODEL=
MISTRAL_MODERATION_MODEL=
MISTRAL_EMBEDDING_MODEL=

# Backend
SERVER_PORT=3200
SLED_DB_PATH=prompt_sentinel_data
RUST_LOG=info

# Security
CORS_ALLOW_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Authentication and RBAC (Phase 2 bootstrap)
AUTH_ENABLED=false
# Format: token:role[:scope1|scope2][@tenant_id[/workspace_id]] (comma-separated)
AUTH_API_KEYS=dev-token:developer:check:invoke|audit:read,viewer-token:compliance_viewer:reports:read|audit:read,admin-token:compliance_admin
AUTH_SERVICE_TOKENS=ci-token:service_account:check:invoke
AUTH_RATE_LIMIT_PER_MINUTE=300
# Optional persistent credential store path (enables key lifecycle persistence across restarts)
AUTH_KEY_STORE_PATH=prompt_sentinel_data/auth_keys.json
# Default generated key TTL in seconds (empty disables default expiry)
AUTH_DEFAULT_KEY_EXPIRY_SECS=

# mTLS service-to-service auth (proxy-terminated)
MTLS_ENABLED=false
MTLS_VERIFIED_HEADER=x-client-cert-verified
MTLS_VERIFIED_VALUE=SUCCESS
MTLS_SUBJECT_HEADER=x-client-cert-subject
MTLS_FINGERPRINT_HEADER=x-client-cert-fingerprint
MTLS_ALLOWED_SUBJECTS=
MTLS_ALLOWED_FINGERPRINTS=
MTLS_ROLE=service_account
MTLS_SCOPES=

# Tenant isolation and quota hooks (Phase 2 baseline)
TENANT_ISOLATION_ENABLED=false
TENANT_ID_HEADER=x-tenant-id
WORKSPACE_ID_HEADER=x-workspace-id
TENANT_REQUIRE_WORKSPACE=false
TENANT_QUOTA_REQUESTS_PER_MINUTE=0
TENANT_QUOTA_MAX_CONCURRENT_REQUESTS=0
TENANT_QUOTA_BACKEND=memory
TENANT_QUOTA_SLED_PATH=prompt_sentinel_data/tenant_quota
TENANT_QUOTA_CONCURRENCY_LEASE_SECS=120
TENANT_POLICY_OVERLAYS_PATH=config/tenant_policy_overlays.json
# If true, startup fails when overlay file cannot be loaded/parsed.
TENANT_POLICY_OVERLAYS_STRICT=false
AUDIT_STORAGE_POLICY_PATH=config/audit_storage_policies.json
# If true, startup fails when audit storage policy file cannot be loaded/parsed.
AUDIT_STORAGE_POLICY_STRICT=false
# Fail-closed region guard for tenant data residency policy checks.
RESIDENCY_ENFORCEMENT_ENABLED=false
# Region label for this deployment (e.g., eu-west-1, us-east-1).
DEPLOYMENT_REGION=global

# OIDC bootstrap (Phase 2 abstraction slice)
OIDC_ENABLED=false
OIDC_PROVIDER=generic
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
# `auto` applies provider-specific claim mappings:
# - auth0: scopes from `scope`/`permissions`; roles from `roles` or namespaced `*/roles`
# - okta: scopes from `scp`/`scope`; roles from `groups`/`roles`
# - azure_ad: scopes from `scp`/`scope`; roles from `roles`/`groups`
# - keycloak: roles from `realm_access.roles` and `resource_access.{client_id}.roles`
# Set an explicit value (or comma-separated list) to override/extend.
OIDC_ROLES_CLAIM=auto
OIDC_SCOPES_CLAIM=auto
# Required for secure OIDC verification when OIDC_ALLOW_INSECURE_JWT_PARSE=false
OIDC_JWKS_URL=
OIDC_JWKS_REFRESH_INTERVAL_SECS=300
OIDC_CLOCK_SKEW_SECS=60
# WARNING: Only for local/dev bootstrap; disables signature verification and parses JWT claims directly.
OIDC_ALLOW_INSECURE_JWT_PARSE=false

# LLM HTTP reliability
LLM_REQUEST_TIMEOUT_SECS=120
LLM_CONNECT_TIMEOUT_SECS=10
LLM_POOL_MAX_IDLE_PER_HOST=20
LLM_POOL_IDLE_TIMEOUT_SECS=90
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_OPEN_DURATION_SECS=30

# Frontend
FRONTEND_PORT=5175
VITE_API_BASE_URL=http://localhost:3200

# Semantic config
SEMANTIC_MEDIUM_THRESHOLD=0.70
SEMANTIC_HIGH_THRESHOLD=0.80
SEMANTIC_DECISION_MARGIN=0.02
